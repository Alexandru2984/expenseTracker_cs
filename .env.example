# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# Never commit the real .env file (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for the API
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=expense_tracker;Username=expense_user;Password=CHANGE_ME

# JWT signing secret — min 32 characters, used to sign/verify authentication tokens
# Generate with: openssl rand -hex 32
Jwt__Secret=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# Comma-separated list of allowed CORS origins (leave empty in production
# when frontend is served same-origin through Nginx)
Cors__AllowedOrigins=

# Host header allow-list (defense against host-header attacks). In production set
# this to your real domain(s), comma-separated. Use * only for local dev.
AllowedHosts=your-domain.example.com

# CIDR ranges of trusted reverse proxies (Nginx/Docker bridge). Forwarded
# headers (X-Forwarded-For/Proto) are only honored from these. Leave unset to
# trust only loopback. For Docker, configure the actual host bridge gateway /32;
# inspect the API's NetworkSettings.Networks.*.Gateway. Do not trust all RFC1918.
# ForwardedHeaders__TrustedNetworks=172.22.0.1/32,127.0.0.1/32,::1/128

# ── Auth / registration ───────────────────────────────────────────────────────
# Set to false to block new account creation (existing users unaffected).
Auth__AllowRegistration=true
# Access/refresh token lifetimes (optional; defaults: 15 min / 14 days)
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=14

# ── SMTP (mailcow) — used to send account verification & password-reset codes ──
Smtp__Host=mail.your-domain.example.com
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__User=noreply@your-domain.example.com
Smtp__Password=CHANGE_ME
Smtp__From=noreply@your-domain.example.com
Smtp__FromName=Expense Tracker

# ── mailcow provisioning (only needed by scripts/provision-mailbox.sh) ─────────
# MAILCOW_HOST=https://mail.your-domain.example.com
# MAILCOW_API_KEY=CHANGE_ME

# ASP.NET Core environment: Production | Development
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL container credentials (used by the db service in docker-compose.yml)
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=CHANGE_ME

# Enable scoped, personal read-only exports to Finance F#. Default: disabled.
FinanceIntegration__Enabled=false

# Optional global email-reminder kill switch. Each account still defaults to opt-out.
# Notifications__Enabled=true

# Optional TOTP MFA enrollment. Independent 32-byte base64 master key.
# Generate once with: openssl rand -base64 32
# Back up privately with the DB; never replace it without re-encrypting secrets.
# Missing key disables enrollment; existing MFA still requires a valid factor.
# Mfa__EncryptionKey=
# Mfa__AllowEnrollment=true
